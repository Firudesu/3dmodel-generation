# Meshy-style OBJ file with proper UV mapping
mtllib meshy_style_test.mtl

# Vertices for a simple pyramid
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 1.0 1.0 0.0
v 0.0 1.0 0.0
v 0.5 0.5 1.0

# Texture coordinates - different regions of texture for each face
vt 0.0 0.0
vt 0.5 0.0
vt 0.5 0.5
vt 0.0 0.5
vt 0.5 0.5
vt 1.0 0.5
vt 1.0 1.0
vt 0.5 1.0
vt 0.0 0.5
vt 0.0 1.0
vt 0.25 0.75
vt 0.75 0.75
vt 0.75 1.0
vt 0.25 1.0

# Material
usemtl pyramid_material

# Faces with proper UV mapping
# Base (quad)
f 1/1 2/2 3/3 4/4
# Side 1 (triangle)
f 1/5 5/6 2/7
# Side 2 (triangle)  
f 2/8 5/9 3/10
# Side 3 (triangle)
f 3/11 5/12 4/13
# Side 4 (triangle)
f 4/14 5/1 1/2